POSTGRES_DB=dineops
POSTGRES_USER=dineops
POSTGRES_PASSWORD=replace_with_strong_db_password
SPRING_PROFILES_ACTIVE=prod

DB_URL=jdbc:postgresql://localhost:5432/dineops
DB_USERNAME=dineops
DB_PASSWORD=replace_with_strong_db_password
DB_POOL_NAME=dineops-hikari
DB_MAX_POOL_SIZE=15
DB_MIN_IDLE=5
DB_IDLE_TIMEOUT_MS=300000
DB_MAX_LIFETIME_MS=1800000
DB_CONNECTION_TIMEOUT_MS=30000
DB_VALIDATION_TIMEOUT_MS=5000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=*
CORS_MAX_AGE_SECONDS=3600

JWT_SECRET=replace_with_64_char_random_hex_secret
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace_with_strong_grafana_password

VITE_API_URL=https://api.example.com
VITE_BASE_PATH=/
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_RELEASE=dineops-frontend-v1
FRONTEND_BASE_URL=https://app.example.com
SMS_PROVIDER=msg91
SMS_SENDER_ID=DINEOP
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@dineops.local
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
DIGEST_SCHEDULE_ENABLED=false
DIGEST_CRON=0 30 23 * * *
DIGEST_FALLBACK_RECIPIENTS=
PAYMENT_PROVIDER=razorpay
PAYMENT_WEBHOOK_SHARED_SECRET=replace_with_webhook_shared_secret
PAYMENT_FRONTEND_BASE_URL=https://app.example.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_RELEASE=dineops-backend-v1

UPTIME_MONITOR_ENABLED=true
UPTIME_CHECK_CRON=0 */5 * * * *
UPTIME_BACKEND_HEALTH_URL=https://api.example.com/actuator/health
UPTIME_FRONTEND_URL=https://app.example.com/
UPTIME_ALERT_COOLDOWN_MINUTES=30
UPTIME_ALERT_EMAIL_RECIPIENTS=owner@example.com
UPTIME_ALERT_WHATSAPP_RECIPIENTS=
UPTIME_ALERT_SLACK_WEBHOOK_URL=
